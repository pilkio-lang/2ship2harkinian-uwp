+#ifdef SM64EX_FRENCH_TEXT
+enum FrenchDiacritic {
+    FR_DIA_NONE, FR_DIA_ACUTE, FR_DIA_GRAVE, FR_DIA_CIRCUMFLEX, FR_DIA_UMLAUT, FR_DIA_CEDILLA
+};
+
+static void render_us_fr_mark(enum FrenchDiacritic mark) {
+    if (mark == FR_DIA_NONE) return;
+
+    if (mark == FR_DIA_CEDILLA) {
+        create_dl_translation_matrix(MENU_MTX_PUSH, 0.0f, -7.0f, 0.0f);
+        render_generic_char(DIALOG_CHAR_COMMA);
+        gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+        return;
+    }
+
+    if (mark == FR_DIA_UMLAUT) {
+        create_dl_translation_matrix(MENU_MTX_PUSH, -1.0f, 7.0f, 0.0f);
+        render_generic_char(DIALOG_CHAR_PERIOD);
+        gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+        create_dl_translation_matrix(MENU_MTX_PUSH, 3.0f, 7.0f, 0.0f);
+        render_generic_char(DIALOG_CHAR_PERIOD);
+        gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+        return;
+    }
+
+    if (mark == FR_DIA_CIRCUMFLEX) {
+        create_dl_translation_matrix(MENU_MTX_PUSH, -1.0f, 7.0f, 0.0f);
+        render_generic_char(ASCII_TO_DIALOG('\''));
+        gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+        create_dl_translation_matrix(MENU_MTX_PUSH, 3.0f, 7.0f, 0.0f);
+        render_generic_char(ASCII_TO_DIALOG('\''));
+        gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+        return;
+    }
+
+    create_dl_translation_matrix(MENU_MTX_PUSH, mark == FR_DIA_GRAVE ? -1.0f : 2.0f, 7.0f, 0.0f);
+    render_generic_char(ASCII_TO_DIALOG('\''));
+    gSPPopMatrix(gDisplayListHead++, G_MTX_MODELVIEW);
+}
+
+static void render_us_fr_diacritic(u8 base, enum FrenchDiacritic mark) {
+    render_generic_char(base);
+    render_us_fr_mark(mark);
+    create_dl_translation_matrix(MENU_MTX_NOPUSH, (f32)gDialogCharWidths[base], 0.0f, 0.0f);
+}
